@page "/consent"
@model Rally.Pages.Consent.IndexModel
@{
    Layout = "/Pages/Shared/_IdentityLayout.cshtml";
    ViewData["Title"] = "Connect Account"; 
}

<div class="rally-auth-container">
    <div class="rally-auth-card">

        <div class="text-center mb-4">
             <img src="~/images/rally.webp" alt="Rally Logo" class="rally-auth-logo" />
             <h1 class="h4 mb-2 fw-normal">Connect with @Model.View.ClientName</h1> @* Adjusted heading *@
             <p class="mb-3" style="color: #ccc;">
                 Please confirm the permissions @Model.View.ClientName will receive.
             </p>
        </div>

        <partial name="_ValidationSummary" />

        <div class="row">
            <div class="col-12"> @* Use full width inside card *@
                <form asp-page="/Consent/Index" method="post">
                    <input type="hidden" asp-for="Input.ReturnUrl" />

                    @* Combine Scope Sections with clear dividers/headings if needed *@
                    @if (Model.View.IdentityScopes?.Any() == true)
                    {
                        <div class="mb-4">
                            <h6 class="text-light border-bottom border-secondary pb-2 mb-3">Basic Profile Information</h6>
                            <ul class="list-unstyled"> @* Use unstyled list *@
                                @foreach (var scope in Model.View.IdentityScopes)
                                {
                                    <partial name="_ScopeListItem" model="scope" /> @* Partial needs adjustment too *@
                                }
                            </ul>
                        </div>
                    }

                    @if (Model.View.ApiScopes?.Any() == true)
                    {
                         <div class="mb-4">
                            <h6 class="text-light border-bottom border-secondary pb-2 mb-3">Application Permissions</h6>
                            <ul class="list-unstyled"> @* Use unstyled list *@
                                @foreach (var scope in Model.View.ApiScopes)
                                {
                                    <partial name="_ScopeListItem" model="scope" />
                                }
                            </ul>
                        </div>
                    }

                    @if (Model.View.AllowRememberConsent)
                    {
                        <div class="form-check mb-4 text-center small">
                            <input class="form-check-input" asp-for="Input.RememberConsent" style="margin-top: 0.2rem;">
                            <label class="form-check-label" asp-for="Input.RememberConsent">
                                Remember my choice for @Model.View.ClientName
                            </label>
                        </div>
                    }

                    <div class="consent-buttons text-center d-grid gap-2 col-10 col-sm-8 mx-auto"> @* Adjust grid columns *@
                        <button name="Input.Button" value="yes" class="btn btn-lg btn-primary rally-button-primary" autofocus>Connect My Rally Account</button>
                        <button name="Input.Button" value="no" class="btn btn-sm btn-link text-muted mt-1" style="text-decoration: none;">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>