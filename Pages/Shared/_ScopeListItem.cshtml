@* File: Rally/Pages/Shared/_ScopeListItem.cshtml *@
@model Rally.Pages.ScopeViewModel

@* Use divs instead of list items for more flexible styling if needed, add bottom margin *@
<div class="mb-3">
    <div class="form-check">
        <input class="form-check-input me-1"
               type="checkbox"
               name="Input.ScopesConsented"
               id="scopes_@Model.Value?.Replace('.', '_')"
               value="@Model.Value"
               checked="@Model.Checked"
               disabled="@Model.Required" />

        <label class="form-check-label" for="scopes_@Model.Value?.Replace('.', '_')">
            <strong>@(Model.DisplayName ?? Model.Value)</strong>
            @if (Model.Emphasize)
            {
                <span class="glyphicon glyphicon-exclamation-sign text-warning ms-1 small"></span>
            }
        </label>

        @if (Model.Required)
        {
            <input type="hidden" name="Input.ScopesConsented" value="@Model.Value" />
        }
    </div>
    @* Conditionally display description *@
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="consent-description ps-4 pt-1"> @* Indent description (using padding start) *@
             <small class="text-white-50">@Model.Description</small>
        </div>
    }
    else @* Fallback Description *@
    {
         <div class="consent-description ps-4 pt-1">
             <small class="text-white-50">
                 @switch (Model.Value)
                 {
                      case Duende.IdentityServer.IdentityServerConstants.StandardScopes.Profile:
                          <span>(Basic profile information like name, etc.)</span>; break;
                      case Duende.IdentityServer.IdentityServerConstants.StandardScopes.Email:
                          <span>(Your email address)</span>; break;
                      // Don't need case for OpenId as it's filtered out
                      default: break;
                 }
             </small>
         </div>
    }
</div>