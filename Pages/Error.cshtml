@page
@model ErrorModel
@{
    // Use the new property name for the title
    ViewData["Title"] = Model.ErrorStatusCode.HasValue ? $"Error {Model.ErrorStatusCode}" : "Error";
    Layout = "/Pages/Shared/_IdentityLayout.cshtml";
}

<div class="rally-auth-container">
    <div class="rally-auth-card text-center text-danger">

         <div class="mb-4">
             <img src="~/images/rally.webp" alt="Rally Logo" class="rally-auth-logo" style="opacity: 0.7;" />
             <h1 class="h3 mb-3 fw-normal">@ViewData["Title"]</h1>
         </div>

        <h2 class="h5 text-danger mb-3">@Model.ErrorMessage</h2>

        @if (Model.ShowRequestId)
        {
            <p class="mt-3">
                <strong class="text-white-50">Request ID:</strong> <code class="text-warning bg-dark p-1 rounded">@Model.RequestId</code>
            </p>
        }
       @if (!string.IsNullOrEmpty(Model.OriginalPath) && Model.ErrorStatusCode.HasValue)
         {
              <p class="small text-muted mt-1">
                 Original path: @Model.OriginalPath
              </p>
         }

         <p class="mt-4">
             @* Provide relevant links based on context *@
             <a asp-page="/Index" class="btn btn-sm btn-secondary me-2">Return Home</a>
             <a asp-page="/Identity/Account/Login" class="btn btn-sm btn-outline-light">Go to Login</a>
         </p>

    </div>
</div>