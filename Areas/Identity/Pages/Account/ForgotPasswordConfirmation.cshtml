@page 
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check Your Email"; 
    Layout = "/Pages/Shared/_IdentityLayout.cshtml"; 
}

<div class="rally-auth-container">
    <div class="rally-auth-card text-center"> 

        <div class="mb-4">
             <img src="~/images/rally.webp" alt="Rally Logo" class="rally-auth-logo" /> @* Update path if needed *@
            <h1 class="h3 mb-3 fw-normal">@ViewData["Title"]</h1>
        </div>

        <p class="text-light mb-4">
            If an account exists for the email address you entered, we've sent a password reset code.
            Please check your inbox (and spam folder) for the code needed to reset your password.
        </p>


         <p class="mt-3 small">
             <a asp-page="./Login">Return to Login</a>
         </p>

    </div>
</div>