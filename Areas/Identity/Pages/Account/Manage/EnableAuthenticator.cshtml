@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure authenticator app";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
     Layout = "/Pages/Shared/_IdentityLayout.cshtml";
}


<h4 class="text-light text-center mb-4">Manage Your Rally Account</h4>

<div class="row justify-content-center">
    <div class="col-lg-3 col-md-4 mb-3">
        <partial name="_ManageNav" />
    </div>
    <div class="col-lg-7 col-md-8">
        <div class="rally-auth-card p-4"> @* Apply card styling *@

            <h5 class="text-light mb-3">@ViewData["Title"]</h5>
            <partial name="_StatusMessage" for="StatusMessage" />

            <div>
                <p class="text-light">To use an authenticator app go through the following steps:</p>
                <ol class="list text-light"> @* Ensure list text is visible *@
                    <li>
                        <p>
                            Download a two-factor authenticator app like Microsoft Authenticator for
                            <a href="https://go.microsoft.com/fwlink/?Linkid=825072" target="_blank" rel="noopener noreferrer">Android</a> and
                            <a href="https://go.microsoft.com/fwlink/?Linkid=825073" target="_blank" rel="noopener noreferrer">iOS</a> or
                            Google Authenticator for
                            <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&hl=en" target="_blank" rel="noopener noreferrer">Android</a> and
                            <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8" target="_blank" rel="noopener noreferrer">iOS</a>.
                        </p>
                    </li>
                    <li>
                        <p>Scan the QR Code or enter this key <kbd class="bg-secondary text-light">@Model.SharedKey</kbd> into your two factor authenticator app. Spaces and casing do not matter.</p>
                        @* QR Code Generation: Needs a client-side JS library like qrcode.js *@
                        @* Check if the scaffold included a QR code library or if you need to add one *@
                         <div class="alert alert-info small">QR Code generation requires a JavaScript library. If not displaying, ensure library is included and script runs.</div>
                         <div id="qrCode" class="p-3 bg-light d-inline-block rounded my-2"></div> @* Style QR code container *@
                         <div id="qrCodeData" data-url="@Model.AuthenticatorUri" style="display: none;"></div> @* Hide data URL *@
                    </li>
                    <li>
                        <p>
                            Once you have scanned the QR code or input the key above, your two factor authentication app will provide you
                            with a unique code. Enter the code in the confirmation box below.
                        </p>
                        <div class="row">
                            <div class="col-md-8"> @* Adjust column width for the input field *@
                                <form id="send-code" method="post">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="123456" aria-required="true"/>
                                        <label asp-for="Input.Code" class="control-label form-label">Verification Code</label>
                                        <span asp-validation-for="Input.Code" class="text-danger"></span>
                                    </div>
                                    <button type="submit" class="w-100 btn btn-primary rally-button-primary">Verify</button>
                                    <div asp-validation-summary="ModelOnly" class="text-danger mt-3" role="alert"></div>
                                </form>
                            </div>
                        </div>
                    </li>
                </ol>
            </div>

        </div> @* End Content Card *@
    </div> @* End Content Column *@
</div> @* End Row *@


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* Add reference to QR code generation library if needed *@
    @* <script type="text/javascript" src="~/lib/qrcodejs/qrcode.min.js"></script> *@
    @* Add script to generate QR code from data attribute *@
    <script type="text/javascript">
        // Ensure this runs after the library is loaded
        // Example using a common qrcode.js library pattern
        var qrCodeDataElement = document.getElementById("qrCodeData");
        if (qrCodeDataElement && typeof QRCode !== 'undefined') {
            new QRCode(document.getElementById("qrCode"), {
                text: qrCodeDataElement.getAttribute('data-url'),
                width: 150, // Adjust size
                height: 150,
                 colorDark: "#1e1e1e", // Dark color for dark theme
                 colorLight: "#ffffff"  // Light color for dark theme
            });
        } else {
             console.error("QR Code library not found or data element missing.");
             // Optionally hide the QR code div or show an error message
             var qrCodeDiv = document.getElementById("qrCode");
             if(qrCodeDiv) qrCodeDiv.style.display = 'none';
        }
    </script>
}