@page 
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
    Layout = "/Pages/Shared/_IdentityLayout.cshtml";
}

<h4 class="text-light text-center mb-4">Manage Your Rally Account</h4>

<div class="row justify-content-center">
    <div class="col-lg-3 col-md-4 mb-3">
        <partial name="_ManageNav" />
    </div>
    <div class="col-lg-7 col-md-8">
        <div class="rally-auth-card p-4"> @* Apply card styling *@

            <h5 class="text-light mb-3">@ViewData["Title"]</h5>

            <p class="text-light">Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
            <p>
                <strong class="text-danger">Deleting this data will permanently remove your Rally account, and this cannot be recovered.</strong>
            </p>
            <div class="mt-4 d-flex flex-wrap gap-2"> @* Use flex for button layout *@
                <form id="download-data" asp-page="DownloadPersonalData" method="post" class="me-2"> @* Add margin end *@
                    <button class="btn btn-primary rally-button-primary" type="submit">Download My Data</button>
                </form>
                @* Consider adding a confirmation modal for delete later *@
                <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">Delete My Account</a>
            </div>

        </div> @* End Content Card *@
    </div> @* End Content Column *@
</div> @* End Row *@

@section Scripts {
    <partial name="_ValidationScriptsPartial" /> @* Keep for potential future validation *@
}