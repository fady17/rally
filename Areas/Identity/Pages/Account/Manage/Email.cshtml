@page
@model EmailModel
@{
    ViewData["Title"] = "Manage Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
    // Layout is set by _ViewStart.cshtml in this folder
}

<h4 class="text-light text-center mb-4">Manage Your Rally Account</h4>

<div class="row justify-content-center">
    <div class="col-lg-3 col-md-4 mb-3">
        <partial name="_ManageNav" />
    </div>
    <div class="col-lg-7 col-md-8">
        <div class="rally-auth-card p-4"> @* Apply card styling *@

            <h5 class="text-light mb-3">@ViewData["Title"]</h5>
            <partial name="_StatusMessage" for="StatusMessage" />

            <form id="email-form" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

                @* Display Current Email *@
                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-white-50"></label>
                    @if (Model.IsEmailConfirmed)
                    {
                        <div class="input-group"> @* Use input group for checkmark *@
                            <input asp-for="Email" class="form-control" disabled />
                            <span class="input-group-text text-success bg-dark border-secondary"><i class="bi bi-check-circle-fill"></i></span> @* BS5 Checkmark Icon Example *@
                        </div>
                    }
                    else
                    {
                        <input asp-for="Email" class="form-control" placeholder="Email is not confirmed." disabled />
                        <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-sm btn-link ps-0 text-info">Send verification email</button> @* Use link style button *@
                         <span asp-validation-for="Input.NewEmail" class="text-danger"></span> @* Validation for NewEmail needed? Maybe not here. *@
                    }
                </div>

                @* Input for New Email *@
                <div class="form-floating mb-3">
                    <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="new-email@example.com" />
                    <label asp-for="Input.NewEmail" class="form-label"></label>
                    <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
                </div>

                <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="w-100 btn btn-primary rally-button-primary">Change email</button>
            </form>

        </div> @* End Content Card *@
    </div> @* End Content Column *@
</div> @* End Row *@

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}