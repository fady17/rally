@page "/Identity/Account/Manage/ChangePassword" // Sets the route
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword; // For nav highlighting
    // Layout is set by _ViewStart.cshtml in this folder
}

@* Add the Title for the Manage section - Centered *@
<h4 class="text-light text-center mb-4">Manage Your Rally Account</h4>

<div class="row justify-content-center"> @* Center the overall row content horizontally *@
    <div class="col-lg-3 col-md-4 mb-3"> @* Sidebar Nav Column *@
        <partial name="_ManageNav" />
    </div>
    <div class="col-lg-7 col-md-8"> @* Content Column *@
        <div class="rally-auth-card p-4"> @* Use card styling for content *@

            <h5 class="text-light mb-3">@ViewData["Title"]</h5> @* Title specific to this page *@
            <partial name="_StatusMessage" for="StatusMessage" />

            <form id="change-password-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                @* Use form-floating for consistent look with Login/Register if desired, or keep standard inputs *@
                <div class="form-floating mb-3">
                    <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.OldPassword" class="form-label"></label>
                    <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.NewPassword" class="form-label"></label>
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password"/>
                    <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="w-100 btn btn-primary rally-button-primary">Update password</button> @* Added custom class *@
            </form>
        </div> @* End Content Card *@
    </div> @* End Content Column *@
</div> @* End Row *@


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}