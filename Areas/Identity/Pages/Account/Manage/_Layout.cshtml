@{

    Layout = "/Pages/Shared/_IdentityLayout.cshtml";
}


<div>
    <h2 class="text-center text-light mb-4">Manage Your Rally Account</h2> @* Add centered title *@
    <div class="row justify-content-center"> @* Center the columns *@
        <div class="col-md-3 mb-3"> @* Column for Nav *@
            @* Style the nav partial container if needed *@
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-9"> @* Column for Content *@
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}