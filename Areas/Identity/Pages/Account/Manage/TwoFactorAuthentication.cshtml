@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Two-factor authentication (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
     // Layout is set by _ViewStart.cshtml in this folder
}

<h4 class="text-light text-center mb-4">Manage Your Rally Account</h4>

<div class="row justify-content-center">
    <div class="col-lg-3 col-md-4 mb-3">
        <partial name="_ManageNav" />
    </div>
    <div class="col-lg-7 col-md-8">
        <div class="rally-auth-card p-4"> @* Apply card styling *@

             <h5 class="text-light mb-3">@ViewData["Title"]</h5>
             <partial name="_StatusMessage" for="StatusMessage" />

            @{
                var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
                // Note: The CanTrack check might need adjustment depending on actual consent implementation
                @if (consentFeature?.CanTrack ?? true)
                {
                    <div class="mb-3"> @* Added wrapper for spacing/structure *@
                        @if (Model.Is2faEnabled)
                        {
                            // --- 2FA Enabled Section ---
                            if (Model.RecoveryCodesLeft == 0)
                            {
                                <div class="alert alert-danger" role="alert">
                                    <strong class="d-block">You have no recovery codes left.</strong>
                                    <p class="mb-0">You must <a asp-page="./GenerateRecoveryCodes" class="alert-link">generate a new set of recovery codes</a> before you can log in with a recovery code.</p>
                                </div>
                            }
                            else if (Model.RecoveryCodesLeft == 1)
                            {
                                <div class="alert alert-danger" role="alert">
                                     <strong class="d-block">You have 1 recovery code left.</strong>
                                     <p class="mb-0">You can <a asp-page="./GenerateRecoveryCodes" class="alert-link">generate a new set of recovery codes</a>.</p>
                                </div>
                            }
                            else if (Model.RecoveryCodesLeft <= 3)
                            {
                                <div class="alert alert-warning" role="alert">
                                    <strong class="d-block">You have @Model.RecoveryCodesLeft recovery codes left.</strong>
                                     <p class="mb-0">You should <a asp-page="./GenerateRecoveryCodes" class="alert-link">generate a new set of recovery codes</a>.</p>
                                </div>
                            }

                            if (Model.IsMachineRemembered)
                            {
                                // Add margin between buttons
                                <form method="post" style="display: inline-block;" class="me-2 mb-2">
                                    <button type="submit" class="btn btn-sm btn-secondary">Forget this browser</button>
                                </form>
                            }
                             <a asp-page="./Disable2fa" class="btn btn-sm btn-danger me-2 mb-2">Disable 2FA</a> @* Use danger for disable *@
                             <a asp-page="./GenerateRecoveryCodes" class="btn btn-sm btn-secondary mb-2">Reset recovery codes</a>
                        }
                        else
                        {
                             <div class="alert alert-info" role="alert">Two-factor authentication is not currently enabled for your account.</div>
                        }
                    </div>

                    <hr style="border-color: #444;"/> @* Separator *@

                     <div class="mt-3"> @* Added wrapper *@
                         <h6 class="text-light mb-3">Authenticator app</h6>
                         @if (!Model.HasAuthenticator)
                         {
                             <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-sm btn-primary rally-button-primary me-2 mb-2">Add authenticator app</a>
                         }
                         else
                         {
                             <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-sm btn-primary rally-button-primary me-2 mb-2">Setup authenticator app</a>
                             <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-sm btn-secondary mb-2">Reset authenticator app</a>
                         }
                     </div>
                }
                else // Cookie consent not granted
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>Privacy and cookie policy have not been accepted.</strong>
                        <p class="mb-0">You must accept the policy before you can enable two factor authentication.</p>
                    </div>
                }
            }

        </div> @* End Content Card *@
    </div> @* End Content Column *@
</div> @* End Row *@


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}