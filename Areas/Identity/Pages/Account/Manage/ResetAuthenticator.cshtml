@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Reset authenticator key";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
     Layout = "/Pages/Shared/_IdentityLayout.cshtml";
}

<h4 class="text-light text-center mb-4">Manage Your Rally Account</h4>

<div class="row justify-content-center">
    <div class="col-lg-3 col-md-4 mb-3">
        <partial name="_ManageNav" />
    </div>
    <div class="col-lg-7 col-md-8">
        <div class="rally-auth-card p-4"> @* Apply card styling *@

            <h5 class="text-light mb-3">@ViewData["Title"]</h5>
            <partial name="_StatusMessage" for="StatusMessage" />

            <div class="alert alert-warning" role="alert"> @* Standard warning alert styling *@
                <p class="mb-1"> @* Use BS margin utility *@
                    @* Replace glyphicon with BS icon if available *@
                    <span class="glyphicon glyphicon-warning-sign"></span>
                    <strong>If you reset your authenticator key your authenticator app will not work until you reconfigure it.</strong>
                </p>
                <p class="mb-0"> @* Use BS margin utility *@
                    This process disables 2FA until you verify your authenticator app.
                    If you do not complete your authenticator app configuration you may lose access to your account.
                </p>
            </div>
            <div>
                <form id="reset-authenticator-form" method="post">
                    <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Reset authenticator key</button>
                </form>
            </div>

        </div> @* End Content Card *@
    </div> @* End Content Column *@
</div> @* End Row *@