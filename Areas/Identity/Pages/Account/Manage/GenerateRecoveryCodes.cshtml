@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generate two-factor authentication (2FA) recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
     Layout = "/Pages/Shared/_IdentityLayout.cshtml";
}

<h4 class="text-light text-center mb-4">Manage Your Rally Account</h4>

<div class="row justify-content-center">
    <div class="col-lg-3 col-md-4 mb-3">
        <partial name="_ManageNav" />
    </div>
    <div class="col-lg-7 col-md-8">
        <div class="rally-auth-card p-4"> @* Apply card styling *@

            <h5 class="text-light mb-3">@ViewData["Title"]</h5>
            <partial name="_StatusMessage" for="StatusMessage" />

            <div class="alert alert-warning" role="alert">
                <p class="mb-1">
                     <span class="glyphicon glyphicon-warning-sign"></span>
                    <strong>Put these codes in a safe place.</strong>
                </p>
                <p class="mb-1">
                    If you lose your device and don't have the recovery codes you will lose access to your account.
                </p>
                <p class="mb-0">
                    Generating new recovery codes does not change the keys used in authenticator apps. If you wish to change the key
                    used in an authenticator app you should <a asp-page="./ResetAuthenticator" class="alert-link">reset your authenticator keys.</a>
                </p>
            </div>
            <div>
                @* Button might be better placed on previous page? Or maybe this page reloads showing codes? *@
                @* Assuming this page reloads to show codes if Model.RecoveryCodes is not null *@
                @if (Model.RecoveryCodes == null || !Model.RecoveryCodes.Any())
                 {
                    <form method="post">
                        <button class="btn btn-danger" type="submit">Generate Recovery Codes</button>
                    </form>
                 }
            </div>

            @* Display Recovery Codes if they exist on the Model after POST *@
            @if (Model.RecoveryCodes?.Any() == true)
            {
                <hr style="border-color: #444;"/>
                <p class="text-light">Your new recovery codes:</p>
                 <div class="row">
                    @for (var i = 0; i < Model.RecoveryCodes.Length; i += 2)
                    {
                        <div class="col-md-6 mb-2">
                             <code class="bg-secondary text-light p-2 rounded d-block text-center">@Model.RecoveryCodes[i]</code>
                         </div>
                        @if (i + 1 < Model.RecoveryCodes.Length)
                        {
                            <div class="col-md-6 mb-2">
                                 <code class="bg-secondary text-light p-2 rounded d-block text-center">@Model.RecoveryCodes[i + 1]</code>
                            </div>
                        }
                    }
                </div>
            }


        </div> @* End Content Card *@
    </div> @* End Content Column *@
</div> @* End Row *@