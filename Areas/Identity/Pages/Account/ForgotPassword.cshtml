@page 
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Your Password?"; // Keep title clear
    Layout = "/Pages/Shared/_IdentityLayout.cshtml"; // Use custom layout
}

<div class="rally-auth-container">
    <div class="rally-auth-card">

        <div class="text-center mb-4">
            <img src="~/images/rally.webp" alt="Rally Logo" class="rally-auth-logo" /> @* Update path if needed *@
            <h1 class="h3 mb-3 fw-normal">@ViewData["Title"]</h1>
            @* Update instructions to mention sending a code *@
            <p class="text-light">Enter your email address below. If an account exists for that email, we will send a code to reset your password.</p>
        </div>

        <div class="row">
            <div class="col-md-10 col-lg-8 mx-auto"> @* Centered form column *@
                <form method="post">
                    @* Use the ValidationSummary partial for model errors *@
                    <partial name="_ValidationSummary" model="ViewData.ModelState" />

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label"></label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    @* Update button text *@
                    <button type="submit" class="w-100 btn btn-lg btn-primary rally-button-primary mb-3">Send Reset Code</button>

                     <div class="text-center small">
                        <p>
                            Remembered your password? <a asp-page="./Login">Log in</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}