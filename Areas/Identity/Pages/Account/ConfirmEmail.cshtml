@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Email Confirmed";
    Layout = "/Pages/Shared/_IdentityLayout.cshtml";
}

<div class="rally-auth-container">
    <div class="rally-auth-card text-center">
         <div class="mb-4">
             <img src="~/images/rally.webp" alt="Rally Logo" class="rally-auth-logo" />
            <h1 class="h3 mb-3 fw-normal">@ViewData["Title"]</h1>
        </div>

        <partial name="_StatusMessage" model="Model.StatusMessage" />

         <p class="text-light mb-4">
            Thank you for confirming your email.
        </p>
        <p class="mt-4">
             <a asp-page="./Login" class="btn btn-primary rally-button-primary">Proceed to Login</a>
         </p>
    </div>
</div>