@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Registration Complete";
    Layout = "/Pages/Shared/_IdentityLayout.cshtml";
}

<div class="rally-auth-container">
    <div class="rally-auth-card text-center">
        <div class="mb-4">
             <img src="~/images/rally.webp" alt="Rally Logo" class="rally-auth-logo" />
            <h1 class="h3 mb-3 fw-normal">@ViewData["Title"]</h1>
        </div>

        @{
            if (@Model.DisplayConfirmAccountLink)
            {
                <p class="text-light mb-4">
                    Check your email inbox (and spam folder) for a confirmation link to activate your account.
                    @* <a id="confirm-link" href="@Model.EmailConfirmationUrl">Click here to confirm your account</a> *@ @* Link removed as we'll use code *@
                </p>
            }
            else
            {
                <p class="text-light mb-4">
                    Please check your email to confirm your account. You must confirm your email before you can log in.
                </p>
            }
        }
         <p class="mt-3 small">
             <a asp-page="./Login">Return to Login</a>
         </p>
    </div>
</div>