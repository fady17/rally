@page
@model Rally.Areas.Identity.Pages.Account.LoggedOutModel
@{
    ViewData["Title"] = "Logged out";
}

<div class="logged-out-page text-center mt-5">
    <h1>@ViewData["Title"]</h1>
    <p class="lead">You have successfully logged out.</p>

    @if (Model.View?.PostLogoutRedirectUri != null)
    {
        <p>
            Click <a class="btn btn-primary" href="@Model.View.PostLogoutRedirectUri">here</a>
            to return to the <span>@Model.View.ClientName</span> application.
        </p>
    }

    @if (Model.View?.SignOutIframeUrl != null)
    {
        <iframe width="0" height="0" class="signout" sandbox="allow-same-origin allow-forms" src="@Model.View.SignOutIframeUrl"></iframe>
    }
</div>

