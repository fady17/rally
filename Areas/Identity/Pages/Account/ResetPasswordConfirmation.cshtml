@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password Reset"; 
    Layout = "/Pages/Shared/_IdentityLayout.cshtml";
}

<div class="rally-auth-container">
    <div class="rally-auth-card text-center"> 

        <div class="mb-4">
             <img src="~/images/rally.webp" alt="Rally Logo" class="rally-auth-logo" /> @* Update path if needed *@
            <h1 class="h3 mb-3 fw-normal">@ViewData["Title"] Complete</h1> @* Combined title *@
        </div>

        <p class="text-light mb-4">
            Your password has been successfully reset.
        </p>

        <p class="mt-4">
            <a asp-page="./Login" class="btn btn-primary rally-button-primary">Click here to Log In</a> @* Clear call to action *@
        </p>

    </div>
</div>