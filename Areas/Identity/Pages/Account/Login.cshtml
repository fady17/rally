@page
@model LoginModel

@{
    Layout = "/Pages/Shared/_IdentityLayout.cshtml";
}



<div class="rally-auth-container"> @* Outer container for centering/background *@
    <div class="rally-auth-card"> @* Card/Panel for the form *@

        <div class="text-center mb-4">
           
            <img src="~/images/rally.webp" alt="Rally Logo" class="rally-auth-logo" />
            <h1 class="h3 mb-3 fw-normal">@ViewData["Title"]</h1>
        </div>

        <div class="row">
            @* Make the local login section potentially wider on medium screens and center it overall *@
            <div class="col-md-12 col-lg-10 mx-auto">
                <section>
                    <form id="account" method="post">
                        @* Changed H2 to P for semantics, less prominent *@
                        <p class="text-center">Use your Rally account to log in.</p>
                        <hr />
                        @* Use the standard _ValidationSummary partial for errors *@
                        <partial name="_ValidationSummary" model="ViewData.ModelState" />
                        @* Display TempData ErrorMessage if set (e.g., by IS interaction) *@
                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                             <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                        }

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="form-label"></label> @* Text comes from Display attribute or property name *@
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="form-label"></label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        <div class="mb-3"> @* Consistent margin bottom *@
                            <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary rally-button-primary">Log in</button> @* Added custom class *@
                        </div>
                          <div class="mb-3 text-end"> @* Link div with bottom margin, optionally right-aligned *@
                            <p class="mb-0">
                                <a id="forgot-password" asp-page="./ForgotPassword" class="small">Forgot your password?</a>
                            </p>
                        </div>
                        <div class="form-check mb-3"> @* Checkbox div with bottom margin *@
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label asp-for="Input.RememberMe" class="form-check-label">
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>

                      

                        
                        <div class="text-center"> @* Center the registration link *@
                            <p>
                                Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
                            </p>
                            @* Hide Resend Confirmation unless needed - uncomment if RequireConfirmedAccount is true *@
                            @* <p>
                                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                            </p> *@
                        </div>
                    </form>
                </section>
            </div>

            @* External Login Section - Keep separate for clarity, hide if not used *@
            @{
                if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="col-md-8 col-lg-6 mx-auto mt-4"> @* Add spacing if external logins exist *@
                         <section>
                            <h4 class="text-center">Use another service to log in.</h4>
                            <hr />
                             <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                                <div>
                                    <p class="text-center"> @* Center buttons *@
                                        @foreach (var provider in Model.ExternalLogins!)
                                        {
                                            <button type="submit" class="btn btn-outline-secondary mb-2" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button> @* Use outline buttons? *@
                                        }
                                    </p>
                                </div>
                            </form>
                        </section>
                    </div>
                }
            }
        </div> @* End row *@
    </div> @* End rally-auth-card *@
</div> @* End rally-auth-container *@


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}