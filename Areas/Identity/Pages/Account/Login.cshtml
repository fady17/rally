@page 
@model LoginModel
@{
    ViewData["Title"] = "Sign In or Create Account";
    Layout = "/Pages/Shared/_IdentityLayout.cshtml";
}

<div class="rally-auth-container">
    <div class="rally-auth-card">
        <div class="text-center mb-4">
            <img src="~/images/rally.webp" alt="Rally Logo" class="rally-auth-logo" />
            <h1 class="h3 mb-3 fw-normal">@ViewData["Title"]</h1>
            <p class="text-muted">Enter your email address to receive a login code.</p>
        </div>

        <div class="row">
            <div class="col-md-10 col-lg-8 mx-auto">
                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <partial name="_StatusMessage" model="@TempData["StatusMessage"]" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" autofocus />
                        <label asp-for="Input.Email" class="form-label"></label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary rally-button-primary">Send Login Code</button>
                </form>
                 <div class="text-center small mt-3">
                    <p>Prefer to use a password? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Login with password</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}