@page 
@model ResetPasswordModel
@{
    ViewData["Title"] = "Set New Password"; // Changed title slightly
    Layout = "/Pages/Shared/_IdentityLayout.cshtml"; // Use custom layout
}


<div class="rally-auth-container">
    <div class="rally-auth-card">

        <div class="text-center mb-4">
             <img src="~/images/rally.webp" alt="Rally Logo" class="rally-auth-logo" /> @* Update path if needed *@
            <h1 class="h3 mb-3 fw-normal">@ViewData["Title"]</h1>
            @* Updated text - assume code was verified *@
            <p class="text-light">Choose a new password for your account associated with @Model.Input?.Email.</p>
        </div>

         <div class="row">
            <div class="col-md-10 col-lg-8 mx-auto"> @* Centered form column *@
                <form method="post">
                    <partial name="_ValidationSummary" model="ViewData.ModelState" />

                    @* --- MODIFIED: Keep Email and Code hidden --- *@
                    @* These values are passed from the previous step and needed for OnPostAsync *@
                    <input asp-for="Input.Email" type="hidden" />
                    <input asp-for="Input.Code" type="hidden" />
                    @* --- END MODIFIED --- *@


                    @* --- Only show Password fields --- *@
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="New Password" autofocus /> @* Add autofocus here *@
                        <label asp-for="Input.Password" class="form-label"></label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm New Password" />
                        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary rally-button-primary">Set New Password</button> @* Updated button text *@
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}